// fastfetch — minimalist informative layout. Deployed to every machine by
// fastfetch/install.sh; edit the repo copy, never ~/.config/fastfetch/config.jsonc.
//
// Logo is a real image drawn with the kitty graphics protocol (ghostty, kitty).
//   It needs the ImageMagick runtime library, which fastfetch dlopen()s and does
//   NOT depend on — packages.sh installs it. Without it, or in a terminal with no
//   kitty graphics, fastfetch quietly falls back to distro ASCII art; run
//   `fastfetch --show-errors` to see which. Alternates live in alt/.
//
// Icons are Font Awesome 4 codepoints, each verified present in MesloLGS NF
//   (that range is stable across Nerd Fonts v2 and v3; the Material Design range
//   is not — it was remapped in v3, so don't reach for nf-md-* icons here).
// Palette mirrors ~/.config/fastfetch/themes/noctalia.jsonc (mauve keys, peach title).
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "kitty",
    "source": "~/.config/fastfetch/logo.png",
    "width": 20,
    "height": 10,
    "padding": { "top": 1, "right": 4 }
  },

  "display": {
    "separator": "  ",
    "key": { "width": 10 },
    "color": {
      "keys": "#cba6f7",
      "title": "#fab387"
    },
    "percent": {
      "type": 3,
      "color": {
        "green": "#94e2d5",
        "yellow": "#fab387",
        "red": "#f38ba8"
      }
    },
    "size": { "ndigits": 1 }
  },

  "modules": [
    "break",
    {
      "type": "title",
      "key": " ",
      "format": "{user-name}@{host-name}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;108;112;134m────────────────────────────────\u001b[0m"
    },

    { "type": "host", "key": " host", "format": "{name}" },
    { "type": "os", "key": " os", "format": "{name} {version-id} {arch}" },
    { "type": "kernel", "key": " kernel", "format": "{release}" },
    { "type": "uptime", "key": " uptime" },
    { "type": "display", "key": " screen", "format": "{width}x{height} @ {refresh-rate} Hz" },

    "break",

    { "type": "cpu", "key": " cpu", "format": "{name} ({cores-logical}) @ {freq-max}" },
    { "type": "cpuusage", "key": " load" },
    { "type": "loadavg", "key": " avg" },
    { "type": "memory", "key": " ram" },
    { "type": "disk", "key": " disk", "folders": "/", "format": "{size-used} / {size-total} ({size-percentage})" },

    "break",
    { "type": "colors", "symbol": "circle", "paddingLeft": 1 },
    "break"
  ]
}
