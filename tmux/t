#!/usr/bin/env sh
# t - tmux task-layout launcher. Stock tmux, zero deps.
# Installed as ~/.local/bin/t; also works directly from this directory.
#
#   t              list running sessions + known layouts
#   t nmap         build (or jump to) the "nmap" session with a 3-pane layout
#
# Pane IDs keep new layouts separate from any currently attached session.
set -eu

name="${1:-}"
if [ -z "$name" ]; then
  tmux ls 2>/dev/null || echo "(no sessions)"
  echo "layouts: nmap  recon"
  exit 0
fi

attach() {
  if [ -n "${TMUX:-}" ]; then tmux switch-client -t "=$1"
  else tmux attach -t "=$1"; fi
}

# Already running? Just go there.
if tmux has-session -t "=$name" 2>/dev/null; then
  attach "$name"; exit 0
fi

case "$name" in
  nmap)
    # big left pane + two stacked on the right (scan / notes / spare shell)
    pane=$(tmux new-session -d -P -F '#{pane_id}' -s nmap -n scan)
    right=$(tmux split-window -h -t "$pane" -P -F '#{pane_id}')
    tmux split-window -v -t "$right"
    tmux select-pane -t "$pane"
    ;;
  recon)
    # main pane on top, short log/output strip on the bottom
    pane=$(tmux new-session -d -P -F '#{pane_id}' -s recon -n main)
    tmux split-window -v -l 30% -t "$pane"
    tmux select-pane -t "$pane"
    ;;
  *)
    echo "unknown layout: $name (try: nmap recon)" >&2
    exit 1
    ;;
esac

attach "$name"
